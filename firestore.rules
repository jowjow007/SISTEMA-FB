rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    // Revisão de segurança (01/11/2026, OWASP ASVS 4.0.3 V4 — controle de acesso).
    // Estar logado NÃO basta: o acesso depende do campo users/{uid}.acesso == 'ativo', que só o admin grava
    // (aprovação explícita em Administração › Usuários). Autocadastro entra como 'pendente'; "Revogar" grava
    // 'bloqueado'; "Excluir" apaga o cadastro e cria acessosRevogados/{uid}, que impede o autocadastro de novo.
    // As abas sozinhas não liberam dados (ver isAtivo). mustChangePassword é só aviso de tela (a própria
    // pessoa consegue zerá-lo), por isso não entra em nenhuma decisão de acesso.
    function temCadastro() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function meuCadastro() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Além da aprovação explícita, exige ao menos uma aba (ou ser admin). Abas e papel só o admin grava, também nas
    // regras antigas; já o campo "acesso" a própria pessoa podia gravar antes desta versão ser publicada. Assim, um
    // autocadastro (sem abas) que tenha se marcado como "ativo" antes da publicação continua sem acesso.
    function isAtivo() {
      return temCadastro() && meuCadastro().get('acesso', '') == 'ativo'
        && meuCadastro().get('role', '') in ['admin', 'gestor', 'membro', 'cliente', 'conselheiro', 'sindico']
        && (meuCadastro().get('role', '') == 'admin' || meuCadastro().get('tabs', []).size() > 0);
    }
    function isEquipe() {
      return isAtivo() && meuCadastro().role in ['admin', 'gestor', 'membro'];
    }
    function isAdmin() {
      return isAtivo() && meuCadastro().role == 'admin';
    }
    // quem o administrador escolheu para cadastrar condomínios e enviar convenções e regimentos (23/11/2026)
    function podeCadastrarCondo() {
      return isAdmin() || (isEquipe() && exists(/databases/$(database)/documents/condoCadastradores/$(request.auth.uid)));
    }
    // Tipos de usuário de fora do escritório (05/11/2026): cliente, conselheiro e síndico têm o mesmo acesso restrito
    function isContaCliente() {
      return isAtivo() && meuCadastro().role in ['cliente', 'conselheiro', 'sindico'];
    }
    function isGestor() {
      return isAtivo() && meuCadastro().role == 'gestor';
    }
    function acessoRevogado() {
      return exists(/databases/$(database)/documents/acessosRevogados/$(request.auth.uid));
    }
    // Robô (Agenda Astrea no PC do escritório): só pela UID, com robos/{uid} criado pelo admin.
    // E-mail não serve: qualquer pessoa pode criar no Auth uma conta com um e-mail ainda não usado.
    function isRobo() {
      return isSignedIn() && exists(/databases/$(database)/documents/robos/$(request.auth.uid));
    }
    // Liberar área restrita (ver temAbaRestrita, mais abaixo) exige que o admin tenha digitado a senha há pouco:
    // o portal pede a senha (reautenticação) e o token passa a ter um auth_time recente. Tirar acesso não exige.
    function ganhou(depois, antes, aba) {
      return depois.get('tabs', []).hasAny([aba]) && !antes.get('tabs', []).hasAny([aba]);
    }
    function ganhouSub(depois, antes, aba, sub) {
      return depois.get('subtabs', {}).get(aba, []).hasAny([sub]) && !antes.get('subtabs', {}).get(aba, []).hasAny([sub]);
    }
    function concedeAreaRestrita(depois, antes) {
      return ganhou(depois, antes, 'contratos-msmo451y') || ganhou(depois, antes, 'remuneracao-variavel-mvrhiayb')
          || ganhouSub(depois, antes, 'gestao-mt9hdjwf', 'colaboradores')
          || ganhouSub(depois, antes, 'numeros-do-escritorio-mscj8kts', 'clientes')
          || ganhouSub(depois, antes, 'numeros-do-escritorio-mscj8kts', 'juizo')
          || ganhouSub(depois, antes, 'numeros-do-escritorio-mscj8kts', 'efetividade');
    }
    function senhaRecente() {
      return request.auth.token.auth_time != null
          && request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(10, 'm');
    }
    match /users/{userId} {
      // a própria pessoa lê o próprio cadastro mesmo pendente/bloqueada (é o que mostra a tela de "aguardando")
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // admin cria contas (Administração › Usuários). O autocadastro entra 'pendente', sem abas, como membro,
      // só com os campos do formulário — e não é aceito para quem foi excluído (acessosRevogados).
      allow create: if (isAdmin() && (!concedeAreaRestrita(request.resource.data, {}) || senhaRecente())) || (
                      isSignedIn() && request.auth.uid == userId
                      && !acessoRevogado()
                      && request.resource.data.role == 'membro'
                      && request.resource.data.tabs.size() == 0
                      && request.resource.data.get('acesso', 'pendente') == 'pendente'
                      && request.resource.data.get('patrimonioVerTudo', false) == false
                      && request.resource.data.get('deptoAtual', '') == ''
                      && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'tabs', 'acesso', 'cpf', 'rg', 'oab',
                           'estadoCivil', 'nacionalidade', 'telefone', 'endereco', 'dataIngresso', 'pixTipo', 'pixChave',
                           'banco', 'agencia', 'conta', 'deptoAtual', 'patrimonioVerTudo', 'createdAt'])
                    );
      // a própria pessoa (ativa) só altera dados pessoais/bancários; papel, acesso, abas, remuneração, cargo,
      // permissões e visão do patrimônio são do admin. A data de entrada só pode ser preenchida enquanto vazia.
      allow update: if (isAdmin() && (!concedeAreaRestrita(request.resource.data, resource.data) || senhaRecente())) || (
                      isAtivo() && request.auth.uid == userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cpf', 'rg', 'oab', 'estadoCivil',
                           'nacionalidade', 'telefone', 'endereco', 'emailAlternativo', 'dataIngresso', 'mustChangePassword',
                           'pixTipo', 'pixChave', 'banco', 'agencia', 'conta', 'dadosBancariosEm', 'sugestoesNotificadas'])
                      && (!('dataIngresso' in request.resource.data.diff(resource.data).affectedKeys())
                          || resource.data.get('dataIngresso', '') == '')
                      && request.resource.data.get('mustChangePassword', false) == false
                    );
      allow delete: if isAdmin();
    }
    // Contas excluídas: impede recriar o próprio cadastro com uma sessão que ainda esteja aberta.
    match /acessosRevogados/{uid} {
      allow read, write: if isAdmin();
    }
    // Registro das ações de segurança do admin (migração de acesso, patrimônio, robôs): só cria e lê.
    match /auditoriaSeguranca/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.porUid == request.auth.uid
                    && request.resource.data.em == request.time;
      allow update, delete: if false;
    }
    // Áreas restritas (02/11/2026): só o admin libera, com a própria senha, em Administração › Usuários › Editar abas.
    // A aba precisa estar em tabs e, nas sub-abas, a sub-aba precisa estar listada em subtabs[aba] (sem lista = sem
    // acesso, ao contrário das sub-abas comuns). O admin vê tudo. Os ids são os do catálogo de abas (coleção tabs):
    // se uma dessas abas for recriada com outro id, atualize aqui e em AREAS_RESTRITAS (index.html).
    function temAbaRestrita(aba) {
      return isAdmin() || (isEquipe() && meuCadastro().get('tabs', []).hasAny([aba]));
    }
    function temSubabaRestrita(aba, sub) {
      return isAdmin() || (isEquipe() && meuCadastro().get('tabs', []).hasAny([aba])
                           && meuCadastro().get('subtabs', {}).get(aba, []).hasAny([sub]));
    }
    // Agenda (teste, 09/11/2026): aba restrita 'agenda-teste' (tools/agenda-teste). Coleções próprias agTeste_*, que podem
    // ser apagadas ao fim do teste. Só quem tem a aba (ou o admin) lê e grava; cliente/processo/publicação só o admin apaga.
    // As permissões finas (advogado, assistente, estagiário) ficam na tela durante o teste.
    function agendaTeste() { return temAbaRestrita('agenda-teste'); }
    match /agTeste_clientes/{id} {
      allow read, create, update: if agendaTeste();
      allow delete: if isAdmin();
    }
    match /agTeste_casos/{id} {
      allow read, create, update: if agendaTeste();
      allow delete: if isAdmin();
    }
    match /agTeste_atividades/{id} {
      allow read, create, update, delete: if agendaTeste();
    }
    match /agTeste_publicacoes/{id} {
      allow read, create, update: if agendaTeste();
      allow delete: if isAdmin();
    }
    // Números dos cadastros (20/11/2026): Cli- (série 'cli') e Prc-/Cas- (série 'proc', a mesma para processos e casos).
    // Cada número sai de uma transação que sobe o contador de 1 em 1; o admin pode criar o contador e reservar um bloco
    // (numerar os cadastros antigos). Nunca desce nem some: dois cadastros ao mesmo tempo não recebem o mesmo número.
    match /agTeste_contadores/{serie} {
      allow read: if agendaTeste();
      allow create: if isAdmin() && serie in ['cli', 'proc'] && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int && request.resource.data.n >= 0;
      allow update: if agendaTeste() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int
                    && (request.resource.data.n == resource.data.n + 1 || (isAdmin() && request.resource.data.n > resource.data.n));
      allow delete: if false;
    }
    // @menções nos comentários da Agenda (20/11/2026): aviso no sino do topo do portal. Quem comenta cria o aviso em seu
    // próprio nome; só a pessoa chamada lê, marca como lido ou apaga (o admin também lê e apaga).
    match /agTeste_mencoes/{id} {
      allow read: if isAdmin() || (isAtivo() && resource.data.para == request.auth.uid);
      allow create: if agendaTeste()
                    && request.resource.data.keys().hasOnly(['para', 'de', 'deNome', 'atividadeId', 'tipo', 'titulo', 'doPrazo', 'trecho', 'em', 'lida'])
                    && request.resource.data.keys().hasAll(['para', 'de', 'atividadeId', 'em', 'lida'])
                    && request.resource.data.de == request.auth.uid && request.resource.data.para is string && request.resource.data.para != request.auth.uid
                    && request.resource.data.atividadeId is string && request.resource.data.atividadeId.size() <= 200
                    && request.resource.data.get('trecho', '').size() <= 300 && request.resource.data.get('titulo', '').size() <= 200
                    && request.resource.data.get('doPrazo', '').size() <= 200 && request.resource.data.get('deNome', '').size() <= 120
                    && request.resource.data.em == request.time && request.resource.data.lida == false;
      allow update: if isAtivo() && resource.data.para == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida', 'lidaEm'])
                    && request.resource.data.lida == true && request.resource.data.lidaEm == request.time;
      allow delete: if isAdmin() || (isAtivo() && resource.data.para == request.auth.uid);
    }
    match /agTeste_config/{id} {
      allow read: if agendaTeste();
      allow write: if isAdmin()
                   || (agendaTeste() && resource != null
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['etiquetas', 'djenAtualizadoEm']));
    }
    // Validações Processuais (24/11/2026, tools/validacoes): pedidos de orientação estratégica sobre publicações.
    // Permissões por pessoa em valPermissoes/{uid} (criar, responder, esclarecer, concluir, reabrir, historico, admin),
    // gravadas só pelo administrador do portal ou do módulo. Cada mudança de situação grava, no mesmo lote, uma mensagem
    // em validacoes/{id}/mensagens — que nunca é alterada nem apagada (correção = mensagem nova que aponta a anterior).
    function valCad() { return get(/databases/$(database)/documents/valPermissoes/$(request.auth.uid)).data; }
    function valTem() { return isEquipe() && exists(/databases/$(database)/documents/valPermissoes/$(request.auth.uid)); }
    function valPode(p) { return isAdmin() || (valTem() && valCad().get(p, false) == true); }
    function valLe(v) {
      return isAdmin() || (isEquipe() && v.get('proximaAcaoUid', '') == request.auth.uid)
          || (valTem() && (request.auth.uid in v.participantes || valCad().get('historico', false) == true || valCad().get('admin', false) == true));
    }
    function valValidador(uid) {
      return exists(/databases/$(database)/documents/valPermissoes/$(uid))
          && get(/databases/$(database)/documents/valPermissoes/$(uid)).data.get('responder', false) == true;
    }
    // a mensagem gravada no mesmo lote (ultimaMov.msgId) tem o tipo esperado e é de quem está agindo
    function valMsg(id, tipos) {
      return existsAfter(/databases/$(database)/documents/validacoes/$(id)/mensagens/$(request.resource.data.ultimaMov.msgId))
          && getAfter(/databases/$(database)/documents/validacoes/$(id)/mensagens/$(request.resource.data.ultimaMov.msgId)).data.tipo in tipos
          && getAfter(/databases/$(database)/documents/validacoes/$(id)/mensagens/$(request.resource.data.ultimaMov.msgId)).data.autorUid == request.auth.uid
          && request.resource.data.ultimaMov.porUid == request.auth.uid
          && request.resource.data.atualizadoEm == request.time;
    }
    function valMuda(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }
    match /valPermissoes/{uid} {
      allow read: if isAdmin() || valTem();
      allow write: if valPode('admin');
    }
    match /valConfig/{doc} {
      allow read: if isAdmin() || valTem();
      allow write: if valPode('admin');
    }
    match /valContadores/{serie} {
      allow read: if isAdmin() || valTem();
      allow create: if valPode('criar') && serie == 'seq' && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if valPode('criar') && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }
    match /validacoes/{id} {
      allow read: if valLe(resource.data);
      allow create: if valPode('criar')
                    && request.resource.data.keys().hasOnly(['seq', 'codigo', 'processo', 'numeroDig', 'assunto', 'dataPublicacao', 'prazoFatal',
                         'prazoValidacao', 'prioridade', 'solicitanteUid', 'solicitanteNome', 'validadorUid', 'validadorNome', 'participantes',
                         'status', 'proximaAcaoUid', 'criadoEm', 'atualizadoEm', 'ultimaMov', 'rodada', 'origemDados', 'reaberturas'])
                    && request.resource.data.solicitanteUid == request.auth.uid
                    && request.resource.data.validadorUid != request.auth.uid
                    && valValidador(request.resource.data.validadorUid)
                    && request.resource.data.participantes.size() == 2
                    && request.resource.data.participantes.hasAll([request.auth.uid, request.resource.data.validadorUid])
                    && request.resource.data.status == 'aguardando'
                    && request.resource.data.proximaAcaoUid == request.resource.data.validadorUid
                    && request.resource.data.prioridade in ['normal', 'alta', 'urgente']
                    && request.resource.data.assunto is string && request.resource.data.assunto.size() > 0 && request.resource.data.assunto.size() <= 300
                    && request.resource.data.seq == getAfter(/databases/$(database)/documents/valContadores/seq).data.n
                    && request.resource.data.criadoEm == request.time
                    && valMsg(id, ['solicitacao']);
      allow update: if isEquipe() && (
          // validador responde (orientação estratégica): a vez passa para quem pediu
          (resource.data.status in ['aguardando', 'aguardando_nova'] && request.auth.uid == resource.data.validadorUid && valPode('responder')
            && request.resource.data.status == 'respondida' && request.resource.data.proximaAcaoUid == resource.data.solicitanteUid
            && valMuda(['status', 'proximaAcaoUid', 'atualizadoEm', 'ultimaMov', 'primeiraRespostaEm', 'respondidaEm'])
            && valMsg(id, ['orientacao']))
          // quem pediu pede esclarecimento: volta para o validador
          || (resource.data.status == 'respondida' && request.auth.uid == resource.data.solicitanteUid && valPode('esclarecer')
            && request.resource.data.status == 'aguardando_nova' && request.resource.data.proximaAcaoUid == resource.data.validadorUid
            && request.resource.data.rodada == resource.data.rodada + 1
            && valMuda(['status', 'proximaAcaoUid', 'atualizadoEm', 'ultimaMov', 'rodada'])
            && valMsg(id, ['esclarecimento']))
          // quem pediu conclui
          || (resource.data.status == 'respondida' && request.auth.uid == resource.data.solicitanteUid && valPode('concluir')
            && request.resource.data.status == 'concluida' && request.resource.data.proximaAcaoUid == null
            && request.resource.data.concluidaEm == request.time
            && valMuda(['status', 'proximaAcaoUid', 'atualizadoEm', 'ultimaMov', 'concluidaEm'])
            && valMsg(id, ['conclusao']))
          // reabrir uma concluída (com motivo): volta para o validador
          || (resource.data.status == 'concluida' && valPode('reabrir') && valLe(resource.data)
            && request.resource.data.status == 'aguardando_nova' && request.resource.data.proximaAcaoUid == resource.data.validadorUid
            && request.resource.data.rodada == resource.data.rodada + 1 && request.resource.data.reaberturas == resource.data.get('reaberturas', 0) + 1
            && valMuda(['status', 'proximaAcaoUid', 'atualizadoEm', 'ultimaMov', 'rodada', 'reaberturas', 'concluidaEm'])
            && valMsg(id, ['reabertura']))
          // alterar prazos/prioridade/assunto ou corrigir uma mensagem: fica registrado no histórico
          || (resource.data.status != 'concluida' && request.auth.uid in resource.data.participantes
            && request.resource.data.status == resource.data.status
            && request.resource.data.prioridade in ['normal', 'alta', 'urgente']
            && request.resource.data.assunto is string && request.resource.data.assunto.size() > 0 && request.resource.data.assunto.size() <= 300
            && valMuda(['prazoFatal', 'prazoValidacao', 'prioridade', 'assunto', 'atualizadoEm', 'ultimaMov'])
            && valMsg(id, ['alteracao', 'correcao']))
        );
      allow delete: if isAdmin();
      match /mensagens/{mid} {
        allow read: if valLe(get(/databases/$(database)/documents/validacoes/$(id)).data);
        allow create: if isEquipe()
                      && request.resource.data.keys().hasOnly(['tipo', 'autorUid', 'autorNome', 'texto', 'resumo', 'analise', 'sugestao', 'anexos', 'em', 'rodada', 'refId', 'motivo', 'alteracoes'])
                      && request.resource.data.autorUid == request.auth.uid
                      && request.resource.data.em == request.time
                      && request.resource.data.tipo in ['solicitacao', 'orientacao', 'esclarecimento', 'conclusao', 'reabertura', 'alteracao', 'correcao']
                      && request.resource.data.texto is string && request.resource.data.texto.size() <= 20000
                      && request.resource.data.get('anexos', []).size() <= 20
                      && getAfter(/databases/$(database)/documents/validacoes/$(id)).data.ultimaMov.msgId == mid
                      && (request.auth.uid in getAfter(/databases/$(database)/documents/validacoes/$(id)).data.participantes
                          || (request.resource.data.tipo == 'reabertura' && valPode('reabrir')));
        allow update, delete: if false;
      }
    }
    // avisos do sino (topo do portal): quem age avisa a outra pessoa da validação; só quem recebe lê e marca como lido
    match /valAvisos/{id} {
      allow read: if isAdmin() || (isAtivo() && resource.data.para == request.auth.uid);
      allow create: if (isAdmin() || valTem())
                    && request.resource.data.keys().hasOnly(['para', 'de', 'deNome', 'validacaoId', 'codigo', 'tipo', 'titulo', 'trecho', 'em', 'lida'])
                    && request.resource.data.de == request.auth.uid && request.resource.data.para != request.auth.uid
                    && request.resource.data.tipo in ['nova', 'orientacao', 'esclarecimento', 'concluida', 'reaberta']
                    && request.resource.data.para in getAfter(/databases/$(database)/documents/validacoes/$(request.resource.data.validacaoId)).data.participantes
                    && request.resource.data.get('trecho', '').size() <= 300 && request.resource.data.get('titulo', '').size() <= 300
                    && request.resource.data.em == request.time && request.resource.data.lida == false;
      allow update: if isAtivo() && resource.data.para == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida', 'lidaEm'])
                    && request.resource.data.lida == true && request.resource.data.lidaEm == request.time;
      allow delete: if isAdmin() || (isAtivo() && resource.data.para == request.auth.uid);
    }
    // Dados que antes ficavam no HTML público (painel de Números, clientes de Condomínios e relatórios em PDF).
    // Números › Clientes, Juízo & Ação e Efetividade ficam em documentos próprios (áreas restritas).
    match /dadosPrivados/{chave} {
      allow read: if (chave == 'numerosClientes' && temSubabaRestrita('numeros-do-escritorio-mscj8kts', 'clientes'))
                  || (chave == 'numerosJuizo' && temSubabaRestrita('numeros-do-escritorio-mscj8kts', 'juizo'))
                  || (chave == 'numerosEfetividade' && temSubabaRestrita('numeros-do-escritorio-mscj8kts', 'efetividade'))
                  || (!(chave in ['numerosClientes', 'numerosJuizo', 'numerosEfetividade']) && isEquipe());
      allow write: if isAdmin();
      // cadastro de condomínio novo: só acrescenta à lista (o texto não pode diminuir)
      allow update: if chave == 'condominios' && podeCadastrarCondo()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['json', 'atualizadoPor', 'atualizadoEm'])
                    && request.resource.data.atualizadoPor == request.auth.uid
                    && request.resource.data.json.size() > resource.data.json.size();
    }
    match /arquivosPrivados/{arquivoId} {
      allow read: if isEquipe();
      allow write: if isAdmin();
      match /partes/{n} {
        allow read: if isEquipe();
        allow write: if isAdmin();
      }
    }
    match /tabs/{tabId} {
      allow read: if isSignedIn();   // catálogo de abas (rótulos/URLs), necessário para montar o menu
      allow write: if isAdmin();
    }
    // Isolamento entre clientes (04/11/2026): cliente (síndico/conselheiro) não lê dados internos da equipe
    // (perfis, organograma, sugestões, notificações de outros condomínios...). Só o próprio perfil.
    match /perfis/{uid} {
      allow read: if isEquipe() || (isSignedIn() && request.auth.uid == uid);
      // o autocadastro grava o próprio perfil (foto/nascimento) antes da aprovação; quem foi excluído não recria
      allow create: if (isSignedIn() && request.auth.uid == uid && !acessoRevogado()) || isAdmin();
      allow update, delete: if isAtivo() && (request.auth.uid == uid || isAdmin());
    }
    match /sugestoes/{sugestaoId} {
      allow read: if isEquipe();
      allow create: if isEquipe()
                    && request.resource.data.autorUid == request.auth.uid
                    && request.resource.data.status == 'aberta'
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() <= 2000
                    && request.resource.data.autorNome is string
                    && request.resource.data.autorNome.size() > 0
                    && request.resource.data.autorNome.size() <= 120
                    && request.resource.data.autorNome.matches('.+ .+')
                    && request.resource.data.motivoExclusao == null;
      allow update: if isAdmin()
                    && resource.data.status == 'aberta'
                    && request.resource.data.texto == resource.data.texto
                    && request.resource.data.autorUid == resource.data.autorUid
                    && request.resource.data.autorNome == resource.data.autorNome
                    && request.resource.data.criadoEm == resource.data.criadoEm
                    && request.resource.data.status in ['implantada', 'excluida']
                    && request.resource.data.decididoPor is string
                    && request.resource.data.decididoEm == request.time
                    && (request.resource.data.status == 'implantada'
                        ? request.resource.data.motivoExclusao == null
                        : (request.resource.data.motivoExclusao is string && request.resource.data.motivoExclusao.size() > 0));
      // Admin pode editar/remover observação em sugestão já implantada
      allow update: if isAdmin()
                    && resource.data.status == 'implantada'
                    && request.resource.data.texto == resource.data.texto
                    && request.resource.data.autorUid == resource.data.autorUid
                    && request.resource.data.status == 'implantada';
      allow delete: if isAdmin();
    }
    match /conversas/{conversaId} {
      allow read: if isAtivo() && request.auth.uid in resource.data.participantes;
      allow create: if isAtivo()
                    && request.auth.uid in request.resource.data.participantes
                    && request.resource.data.participantes.size() >= 2
                    && request.resource.data.criadoPor == request.auth.uid;
      allow update: if isAtivo()
                    && request.auth.uid in resource.data.participantes
                    && request.auth.uid in request.resource.data.participantes;
      allow delete: if false;

      match /mensagens/{mensagemId} {
        allow read: if isAtivo()
                    && request.auth.uid in get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes;
        allow create: if isAtivo()
                      && request.auth.uid in get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes
                      && request.resource.data.autorUid == request.auth.uid;
        allow update: if isAtivo()
                      && request.auth.uid in get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes
                      && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lidaPor','reacoes'])
                          // áudio (16/11/2026): a transcrição chega depois do envio; só esses campos, só em mensagem de áudio
                          || (resource.data.get('tipo', '') == 'audio'
                              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['transcricao', 'transcricaoStatus'])
                              && request.resource.data.get('transcricaoStatus', '') in ['ok', 'vazio', 'falhou', 'pendente']
                              && (request.resource.data.get('transcricao', null) == null
                                  || (request.resource.data.transcricao is string && request.resource.data.transcricao.size() <= 8000))));
        allow delete: if false;
      }
    }
    match /chatPrefs/{uid}/{document=**} {
      allow read, write: if isAtivo() && request.auth.uid == uid;
    }
    match /pendGrupos/{grupoId} {
      allow read, delete: if isAtivo() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAtivo()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 0
                    && request.resource.data.nome.size() <= 80
                    && request.resource.data.emoji is string;
      allow update: if isAtivo()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
    }
    match /pendTarefas/{tarefaId} {
      allow read, delete: if isAtivo() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAtivo()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() <= 2000
                    && request.resource.data.grupoId is string
                    && request.resource.data.concluida == false;
      allow update: if isAtivo()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
    }
    match /tarefasEnviadas/{envioId} {
      allow read: if isAtivo() &&
                    (resource.data.remetenteUid == request.auth.uid || resource.data.destinatarioUid == request.auth.uid);
      allow create: if isAtivo() && (isAdmin() || isGestor())
                    && request.resource.data.remetenteUid == request.auth.uid
                    && request.resource.data.destinatarioUid is string
                    && request.resource.data.destinatarioUid != request.auth.uid
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() <= 2000
                    && request.resource.data.status == 'pendente';
      allow update: if isAtivo() && (
                      (
                        request.auth.uid == resource.data.destinatarioUid
                        && resource.data.status in ['pendente', 'reprovada']
                        && request.resource.data.status == 'aguardando_aprovacao'
                        && request.resource.data.remetenteUid == resource.data.remetenteUid
                        && request.resource.data.destinatarioUid == resource.data.destinatarioUid
                        && request.resource.data.texto == resource.data.texto
                        && request.resource.data.justificativaConclusao is string
                        && request.resource.data.justificativaConclusao.size() > 0
                      ) || (
                        request.auth.uid == resource.data.remetenteUid
                        && resource.data.status == 'aguardando_aprovacao'
                        && request.resource.data.status in ['aprovada', 'reprovada']
                        && request.resource.data.remetenteUid == resource.data.remetenteUid
                        && request.resource.data.destinatarioUid == resource.data.destinatarioUid
                        && request.resource.data.texto == resource.data.texto
                        && (request.resource.data.status == 'aprovada'
                            || (request.resource.data.motivoReprovacao is string && request.resource.data.motivoReprovacao.size() > 0))
                      )
                    );
      // histórico da tarefa (Minhas Anotações › registrarHistorico): remetente ou destinatário só acrescentam
      // ao campo historico. Antes não havia regra para isso e o histórico nunca era gravado (erro silencioso).
      allow update: if isAtivo()
                    && (resource.data.remetenteUid == request.auth.uid || resource.data.destinatarioUid == request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['historico'])
                    && request.resource.data.historico is list
                    && request.resource.data.historico.size() > resource.data.get('historico', []).size();
      allow delete: if isAtivo() && (resource.data.remetenteUid == request.auth.uid || isAdmin());
    }
    // Comunicados (lista em comunicados.js): cada pessoa grava só a própria ciência, uma vez, com a hora do servidor.
    // A pessoa lê as próprias ciências; o administrador lê todas (botão "Ver ciências" no histórico do megafone).
    match /comunicadosCiencia/{docId} {
      allow read: if isAtivo() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAtivo()
                    && request.resource.data.uid == request.auth.uid
                    && docId == request.resource.data.comunicadoId + '_' + request.auth.uid
                    && request.resource.data.em == request.time;
      allow update, delete: if false;
    }
    // Contrato de associação (Contratos › Contrato de associação + tela obrigatória no login, contrato-associacao.js).
    // modelo: texto do contrato e quem assina (só o admin lê — o site é público, o texto não fica no código);
    // regras: só a chave "exigirAssinatura", que a tela de login de todo usuário ativo precisa ler.
    match /contratosAssociacaoConfig/{docId} {
      allow read: if isAdmin() || (docId == 'regras' && isAtivo());
      allow write: if isAdmin();
    }
    // Admin cria já assinado pela sociedade (com a senha digitada há pouco) e depois só cancela/encerra — nunca mexe
    // no texto nem nas assinaturas. O associado só assina (uma vez, com a senha) o texto que recebeu; o diretor
    // interveniente só acrescenta a assinatura dele. Ninguém apaga.
    match /contratosAssociacao/{docId} {
      allow read: if isAdmin()
                  || (isAtivo() && (resource.data.associadoUid == request.auth.uid
                                    || resource.data.get('diretorUid', '') == request.auth.uid));
      allow create: if isAdmin() && senhaRecente()
                    && request.resource.data.status == 'aguardando_associado'
                    && request.resource.data.associadoUid is string
                    && request.resource.data.textoFinal is string
                    && request.resource.data.hashTexto is string
                    && request.resource.data.sociedade.uid == request.auth.uid
                    && request.resource.data.sociedade.assinaturaPng is string
                    && request.resource.data.sociedade.assinadoEm == request.time
                    && !('associado' in request.resource.data)
                    && !('interveniente' in request.resource.data);
      allow update: if (isAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'canceladoEm', 'canceladoPorUid', 'encerradoEm', 'encerradoPorUid'])
                        && ((resource.data.status == 'aguardando_associado' && request.resource.data.status == 'cancelado')
                            || (resource.data.status == 'assinado' && request.resource.data.status == 'encerrado')))
                    || (isAtivo() && senhaRecente()
                        && resource.data.associadoUid == request.auth.uid
                        && resource.data.status == 'aguardando_associado'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'associado', 'assinadoEm', 'assinadoEmISO'])
                        && request.resource.data.status == 'assinado'
                        && request.resource.data.assinadoEm == request.time
                        && request.resource.data.associado.uid == request.auth.uid
                        && request.resource.data.associado.assinaturaPng is string
                        && request.resource.data.associado.assinadoEm == request.time)
                    || (isAtivo() && senhaRecente()
                        && resource.data.get('diretorUid', '') == request.auth.uid
                        && resource.data.status in ['aguardando_associado', 'assinado']
                        && !('interveniente' in resource.data)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interveniente'])
                        && request.resource.data.interveniente.uid == request.auth.uid
                        && request.resource.data.interveniente.assinaturaPng is string
                        && request.resource.data.interveniente.assinadoEm == request.time);
      allow delete: if false;
    }

    // Remuneração variável (tools/remuneracao): só o dono configura, lança o lucro e libera pessoas.
    // Cada pessoa liberada lê apenas o próprio cadastro e o próprio extrato — nem outros admins veem o resto.
    function isDonoRemuneracao() {
      return isAtivo() && request.auth.token.email == 'jonathan@fonsecaebraga.com.br';
    }
    match /remuneracaoConfig/{docId} {
      allow read, write: if isDonoRemuneracao();
    }
    match /remuneracaoMeses/{mes} {
      allow read, write: if isDonoRemuneracao();
    }
    match /remuneracaoPessoas/{uid} {
      allow read: if isDonoRemuneracao()
                  || (isAtivo() && request.auth.uid == uid && resource.data.liberado == true);
      allow write: if isDonoRemuneracao();
    }
    match /remuneracaoExtrato/{uid}/meses/{mes} {
      allow read: if isDonoRemuneracao()
                  || (isAtivo() && request.auth.uid == uid
                      && exists(/databases/$(database)/documents/remuneracaoPessoas/$(uid))
                      && get(/databases/$(database)/documents/remuneracaoPessoas/$(uid)).data.liberado == true);
      allow write: if isDonoRemuneracao();
    }

    // Agenda do Astrea (Números do Escritório › Agenda — Astrea): o robô do PC do escritório
    // (scripts/astrea-importer, conta do robô no login do portal) grava a agenda do dia e o delta.
    // astreaTrigger/pedido é o botão "Executar robô agora": o portal cria/apaga o pedido, o robô atualiza o status.
    // Revisão de segurança (01/11/2026): só a equipe lê a agenda; só o robô (ou o admin) grava a agenda e o delta.
    // Antes de publicar, confirme o e-mail do robô do PC do escritório em isRobo() ou crie robos/{uid}.
    match /astreaDiario/{data} {
      allow read: if isEquipe() || isRobo();
      allow write: if isRobo() || isAdmin();
    }
    match /astreaDelta/{data} {
      allow read: if isEquipe() || isRobo();
      allow write: if isRobo() || isAdmin();
    }
    match /astreaTrigger/{docId} {
      allow read, write: if isEquipe() || isRobo();
    }
    match /robos/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Conferência de e-mails (tools/conferencia-emails): o robô (conta de serviço, fora destas regras) cria
    // e atualiza os documentos. O admin vê todos, troca o responsável, ignora e reabre; cada responsável
    // vê só os seus e, enquanto o e-mail está aberto, pode: marcar como respondido; ignorar (com justificativa
    // obrigatória, v267); ou enviar para outro colega (v267) — o envio fica registrado em emailsConferenciaEnvios
    // na mesma gravação. coResponsaveis (lista gravada pelo robô): quem divide a caixa com o responsável
    // (piloto do jurídico, 19/11/2026) vê e age do mesmo jeito.
    function respConferencia(d) {
      return d.responsavelEmail == request.auth.token.email
          || request.auth.token.email in d.get('coResponsaveis', []);
    }
    function confMarcarRespondido() {
      return request.resource.data.status == 'respondido'
          && request.resource.data.respondidoModo == 'manual'
          && request.resource.data.respondidoPor == request.auth.token.email
          && request.resource.data.respondidoEm == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'respondidoModo', 'respondidoPor', 'respondidoEm']);
    }
    function confIgnorar() {
      return request.resource.data.status == 'ignorado'
          && request.resource.data.ignoradoPor == request.auth.token.email
          && request.resource.data.ignoradoEm == request.time
          && request.resource.data.ignoradoMotivo is string
          && request.resource.data.ignoradoMotivo.size() >= 5
          && request.resource.data.ignoradoMotivo.size() <= 1000
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'ignoradoPor', 'ignoradoEm', 'ignoradoMotivo']);
    }
    // Enviar para outro colega: o e-mail passa a ser só dele (a lista de quem divide é zerada) e o registro do
    // envio (emailsConferenciaEnvios/{envioId}) tem de existir ao fim da mesma gravação, apontando para cá.
    function confEnviar(docId) {
      let novo = request.resource.data;
      let envio = getAfter(/databases/$(database)/documents/emailsConferenciaEnvios/$(novo.envioId)).data;
      return novo.status == 'pendente'
          && novo.responsavelEmail is string
          && novo.responsavelEmail.matches('[a-z0-9._%+-]+@fonsecaebraga[.]com[.]br')
          && novo.responsavelNome is string && novo.responsavelNome.size() <= 120
          && novo.coResponsaveis == [] && novo.coResponsaveisNomes == []
          && novo.atribuidoPor == request.auth.token.email
          && novo.atribuidoEm == request.time
          && novo.envioId is string
          && novo.diff(resource.data).affectedKeys()
               .hasOnly(['responsavelEmail', 'responsavelNome', 'coResponsaveis', 'coResponsaveisNomes', 'atribuidoPor', 'atribuidoEm', 'envioId'])
          && envio.emailId == docId
          && envio.porEmail == request.auth.token.email
          && envio.paraEmail == novo.responsavelEmail;
    }
    match /emailsConferencia/{docId} {
      allow read: if isAdmin()
                  || (isAtivo() && respConferencia(resource.data));
      allow update: if isAdmin()
                    || (isAtivo()
                        && respConferencia(resource.data)
                        && resource.data.status == 'pendente'
                        && (confMarcarRespondido() || confIgnorar() || confEnviar(docId)));
      allow create, delete: if false;
    }
    // Registro de cada "Enviar para…" (aba Enviados): quem enviou e quem recebeu leem; o admin lê todos.
    // Só é criado junto com a troca do responsável (conferida com getAfter dos dois lados); nunca muda nem some.
    match /emailsConferenciaEnvios/{envioId} {
      allow read: if isAdmin()
                  || (isAtivo() && (resource.data.porEmail == request.auth.token.email
                                    || resource.data.paraEmail == request.auth.token.email));
      allow create: if isAtivo()
                    && request.resource.data.keys().hasOnly(['emailId', 'porEmail', 'porNome', 'paraEmail', 'paraNome', 'em', 'recado',
                                                              'assunto', 'remetente', 'remetenteEmail', 'caixa', 'recebidoEm'])
                    && request.resource.data.keys().hasAll(['emailId', 'porEmail', 'paraEmail', 'em'])
                    && request.resource.data.porEmail == request.auth.token.email
                    && request.resource.data.em == request.time
                    && request.resource.data.get('recado', '') is string
                    && request.resource.data.get('recado', '').size() <= 1000
                    && request.resource.data.get('porNome', '') is string && request.resource.data.get('porNome', '').size() <= 120
                    && request.resource.data.get('paraNome', '') is string && request.resource.data.get('paraNome', '').size() <= 120
                    && request.resource.data.get('assunto', '') is string && request.resource.data.get('assunto', '').size() <= 1000
                    && (isAdmin() || respConferencia(get(/databases/$(database)/documents/emailsConferencia/$(request.resource.data.emailId)).data))
                    && getAfter(/databases/$(database)/documents/emailsConferencia/$(request.resource.data.emailId)).data.get('envioId', '') == envioId
                    && getAfter(/databases/$(database)/documents/emailsConferencia/$(request.resource.data.emailId)).data.responsavelEmail == request.resource.data.paraEmail;
      allow update, delete: if false;
    }
    // Resumo da última rodada do robô (data/hora mostrada a todos na aba; contagens e erro só aparecem para admin).
    match /emailsConferenciaMeta/{docId} {
      allow read: if isEquipe();
      allow write: if false;
    }
    // Textos dos e-mails e das respostas (nunca apagados) e lista do que o robô descartou: só o dono lê.
    // O responsável só pode gravar a própria anotação de "Marcar respondido" (nota), nada mais.
    function isDonoConferencia() {
      return isAtivo() && request.auth.token.email == 'jonathan@fonsecaebraga.com.br';
    }
    match /emailsConferenciaTextos/{docId} {
      allow read: if isDonoConferencia();
      allow create, update: if isDonoConferencia()
                            || (isAtivo()
                                && respConferencia(get(/databases/$(database)/documents/emailsConferencia/$(docId)).data)
                                && request.resource.data.notaPor == request.auth.token.email
                                && request.resource.data.notaEm == request.time
                                && (resource == null
                                    ? request.resource.data.keys().hasOnly(['nota', 'notaPor', 'notaEm'])
                                    : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nota', 'notaPor', 'notaEm'])));
      allow delete: if false;
    }
    match /emailsConferenciaDescartes/{docId} {
      allow read: if isDonoConferencia();
      allow write: if false;
    }
    // Contratos é área restrita: só quem tem a aba (liberada pelo admin com senha) lê e gera contratos.
    // A mesma coleção guarda o histórico do Criador de Documentos (procuração, recibo...), com tipos próprios:
    // esses a equipe toda usa (a consulta do Criador filtra por esses tipos).
    function tipoDoCriadorDeDocumentos(t) {
      return t in ['procuracao', 'substabelecimento', 'hipossuficiencia', 'termo_repasse', 'recibo', 'carta_preposicao', 'peticao_ciencia'];
    }
    match /contratosGerados/{docId} {
      allow read: if temAbaRestrita('contratos-msmo451y') || (isEquipe() && tipoDoCriadorDeDocumentos(resource.data.tipo));
      allow create: if (temAbaRestrita('contratos-msmo451y') || (isEquipe() && tipoDoCriadorDeDocumentos(request.resource.data.tipo)))
                    && request.resource.data.criadoPorUid == request.auth.uid
                    && request.resource.data.tipo is string
                    && request.resource.data.nomeDisplay is string
                    && request.resource.data.dados is map;
      allow update: if false;
      allow delete: if isAtivo() && (resource.data.criadoPorUid == request.auth.uid || isAdmin());
    }
    match /peticoes_historico/{docId} {
      allow read: if isAtivo() && resource.data.criadoPor == request.auth.uid;
      allow create: if isAtivo()
                    && request.resource.data.criadoPor == request.auth.uid
                    && request.resource.data.nomeArquivo is string
                    && request.resource.data.docsUrl is string;
      allow update: if false;
      allow delete: if isAtivo() && (resource.data.criadoPor == request.auth.uid || isAdmin());
    }
    // Assinantes do Formatador de petições (10/11/2026): só nome + OAB (ou CPF de quem não tem OAB) da equipe.
    // O admin mantém (o formatador sincroniza a partir de users, que só ele lê); equipe lê; cliente não.
    match /assinantes/{uid} {
      allow read: if isEquipe();
      allow write: if isAdmin()
                   && (request.resource == null
                       || (request.resource.data.keys().hasOnly(['nome', 'oab', 'uf', 'cpf', 'ordem', 'atualizadoEm'])
                           && request.resource.data.nome is string));
    }
    // Espelho do diretório de colegas: só nome, e-mail, departamento, ingresso e cargo.
    // Remuneração e custos NÃO podem mais ser gravados aqui (ficam só em users, legível pelo admin).
    match /organograma/{uid} {
      allow read: if isEquipe();
      // apagar não tem request.resource: fica numa regra própria (botão "Remover" e a conta de teste)
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
                   && !('remuneracao' in request.resource.data && request.resource.data.remuneracao != '')
                   && !('custos' in request.resource.data && request.resource.data.custos != null);
      allow create: if isSignedIn() && request.auth.uid == uid && !acessoRevogado()
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.deptoAtual == ''
                    && request.resource.data.dataIngresso == ''
                    && request.resource.data.get('remuneracao', '') == ''
                    && request.resource.data.keys().hasOnly(['displayName', 'email', 'deptoAtual', 'dataIngresso', 'remuneracao', 'updatedAt']);
    }
    function isAprovadorDoCondo(slug) {
      return isAtivo() &&
        exists(/databases/$(database)/documents/condoAprovadores/$(slug)) &&
        get(/databases/$(database)/documents/condoAprovadores/$(slug)).data.aprovadorUid == request.auth.uid;
    }
    match /condoAprovadores/{slug} {
      allow read: if isEquipe() || (isAtivo() && resource.data.aprovadorUid == request.auth.uid);
      allow write: if isAdmin();
    }
    match /unidadeResets/{docId} {
      allow read: if isEquipe();
      allow write: if isAdmin();
    }
    match /condoUnidades/{slug} {
      allow read: if isEquipe();
      allow write: if isAdmin();
      allow create: if podeCadastrarCondo();
    }
    match /condoCadastradores/{uid} {
      allow read: if isAdmin() || (isEquipe() && request.auth.uid == uid);
      allow write: if isAdmin();
    }
    // CPF/CNPJ de síndico, subsíndico e conselheiros (23/11/2026): só o administrador lê e grava
    match /condoFichaRestrita/{slug} {
      allow read, write: if isAdmin();
      allow create: if podeCadastrarCondo();   // quem cadastra informa o CPF, mas não lê os CPFs guardados
    }
    match /notificacoesGeradas/{docId} {
      // o síndico aprovador lê só as do próprio condomínio (a consulta filtra por condominioSlug)
      allow read: if isEquipe() || isAprovadorDoCondo(resource.data.condominioSlug);
      allow create: if isEquipe()
                    && request.resource.data.criadoPorUid == request.auth.uid
                    && request.resource.data.status == 'pendente'
                    && request.resource.data.tentativa == 1
                    && request.resource.data.condominio is string
                    && request.resource.data.condominioSlug is string
                    && request.resource.data.texto is string && request.resource.data.texto.size() > 0;
      allow update: if isAtivo() && (
                      (
                        resource.data.criadoPorUid == request.auth.uid
                        && resource.data.status == 'rejeitada'
                        && request.resource.data.status == 'pendente'
                        && request.resource.data.criadoPorUid == resource.data.criadoPorUid
                        && request.resource.data.condominio == resource.data.condominio
                        && request.resource.data.condominioSlug == resource.data.condominioSlug
                        && request.resource.data.tentativa == resource.data.tentativa + 1
                      ) || (
                        resource.data.status == 'pendente'
                        && (isAdmin() || isAprovadorDoCondo(resource.data.condominioSlug))
                        && request.resource.data.status in ['aprovada', 'rejeitada']
                        && request.resource.data.decididoPorUid == request.auth.uid
                        && request.resource.data.criadoPorUid == resource.data.criadoPorUid
                        && request.resource.data.texto == resource.data.texto
                        && request.resource.data.condominioSlug == resource.data.condominioSlug
                        && (request.resource.data.status == 'aprovada'
                            || (request.resource.data.motivoRejeicao is string && request.resource.data.motivoRejeicao.size() > 0))
                      )
                    );
      allow delete: if isAdmin();
    }
    // só quem o admin marcou em "⚙ Quem vê tudo" (patrimonioVerTudo == true) vê todo o patrimônio;
    // sem o campo, vê só o que está sob a própria responsabilidade (migração explícita antes de publicar)
    function podeVerTudoPatrimonio() {
      return isAdmin() || (isEquipe() && meuCadastro().get('patrimonioVerTudo', false) == true);
    }
    function temPermGestao(campo) {
      return isAtivo() &&
        exists(/databases/$(database)/documents/permissoesGestao/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/permissoesGestao/$(request.auth.uid)).data.get(campo, false) == true;
    }
    function podeCadastrarPatrimonio() {
      return isAdmin() || temPermGestao('patrimonioCadastro');
    }
    match /permissoesGestao/{uid} {
      allow read: if isAtivo() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    // Gestão › Colaboradores › Pagamentos (só admin): pagamentos marcados por mês e colaboradores
    // excluídos do portal que ainda aguardam o pagamento proporcional (com data de saída e dados bancários).
    match /pagamentosColaboradores/{docId} {
      allow read, write: if isAdmin();
    }
    match /colaboradoresDesligados/{uid} {
      allow read, write: if isAdmin();
    }
    // Gestão › Colaboradores › Holerites e guias: quem lança (admin ou permissão "lancarHolerites") só cria;
    // o admin lê e apaga tudo; cada colaborador lê só os documentos com o próprio uid (holerite).
    // Guias de FGTS/INSS/tributos não têm uid: só o admin vê. O arquivo fica em partes (base64) na subcoleção.
    function podeLancarHolerites() {
      return isAdmin() || temPermGestao('lancarHolerites');
    }
    match /holeritesDocs/{docId} {
      // quem lança vê só a LISTA (colaborador, tipo, competência), para o lembrete mensal saber quem falta;
      // o arquivo (partes) continua só com o admin e com o próprio colaborador
      allow read: if isAdmin() || (isAtivo() && resource.data.uid == request.auth.uid) || podeLancarHolerites();
      allow create: if podeLancarHolerites()
                    && request.resource.data.enviadoPorUid == request.auth.uid
                    && request.resource.data.tipo in ['holerite', 'fgts', 'inss', 'tributo']
                    && request.resource.data.partes is int && request.resource.data.partes <= 20;
      allow update: if false;
      allow delete: if isAdmin();
      match /partes/{n} {
        allow read: if isAdmin()
                    || (isAtivo() && get(/databases/$(database)/documents/holeritesDocs/$(docId)).data.uid == request.auth.uid);
        allow create: if podeLancarHolerites();
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
    match /materiaisMarca/{docId} {
      allow read: if isEquipe();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }
    match /patrimonio/{itemId} {
      allow read: if isEquipe() && (podeVerTudoPatrimonio()
                    || podeCadastrarPatrimonio()
                    || resource.data.responsavelUid == request.auth.uid
                    || resource.data.pendenteParaUid == request.auth.uid);
      allow create: if podeCadastrarPatrimonio()
                    && request.resource.data.nome is string && request.resource.data.nome.size() > 0
                    && request.resource.data.codigo is string
                    && request.resource.data.criadoPorUid == request.auth.uid;
      allow update: if podeCadastrarPatrimonio()
                    || (isAtivo()
                        && resource.data.pendenteParaUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['responsavelUid', 'responsavel', 'pendenteParaUid', 'pendente', 'ultimaRecusa', 'termoAtualId', 'historico', 'atualizadoEm'])
                        && (request.resource.data.responsavelUid == request.auth.uid
                            || request.resource.data.responsavelUid == resource.data.responsavelUid))
                    || (isAtivo()
                        && resource.data.responsavelUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['devolucao', 'devolucaoPendente', 'historico', 'atualizadoEm']));
      allow delete: if isAdmin();
    }
    match /termosPatrimonio/{termoId} {
      allow read: if podeCadastrarPatrimonio() || (isAtivo() && resource.data.colaboradorUid == request.auth.uid);
      allow create: if isAtivo()
                    && request.resource.data.itemId is string
                    && request.resource.data.assinaturaPng is string
                    && request.resource.data.assinadoEm == request.time
                    && ((request.resource.data.colaboradorUid == request.auth.uid
                         && request.resource.data.get('tipoTermo', 'entrega') == 'entrega')
                        || (podeCadastrarPatrimonio()
                            && request.resource.data.tipoTermo == 'devolucao'
                            && request.resource.data.recebidoPorUid == request.auth.uid));
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /senhasDiversas/{docId} {
      allow read: if isAdmin() || temPermGestao('senhasDiversas');
      allow write: if false;
    }
    match /senhasRestritas/{docId} {
      allow read: if isAdmin() || temPermGestao('senhasRestritas');
      allow write: if false;
    }
    match /senhasSync/{colecao} {
      allow read: if isEquipe();
      allow write: if false;
    }
    match /contadores/{contadorId} {
      allow read, write: if isEquipe();
    }
    match /compras/{docId} {
      allow read: if isEquipe();
      allow create: if isEquipe()
                    && request.resource.data.item is string && request.resource.data.item.size() > 0
                    && request.resource.data.status in ['rascunho', 'pendente']
                    && request.resource.data.solicitanteUid == request.auth.uid;
      allow update: if isAdmin() || (
                      isAtivo()
                      && resource.data.solicitanteUid == request.auth.uid
                      && resource.data.status == 'rascunho'
                      && request.resource.data.status == 'pendente'
                      && request.resource.data.item == resource.data.item
                      && request.resource.data.solicitanteUid == resource.data.solicitanteUid
                    );
      allow delete: if isAdmin() || (
                      isAtivo()
                      && resource.data.solicitanteUid == request.auth.uid
                      && resource.data.status == 'rascunho'
                    );
    }
    match /treinamentoProgresso/{uid} {
      allow read: if isAtivo() && (request.auth.uid == uid || isAdmin() || isGestor());
      allow create, update: if isAtivo() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }
    match /presencaDiaria/{docId} {
      allow read: if isEquipe();
      allow create, update: if isAtivo() && request.resource.data.uid == request.auth.uid
                            && docId.matches(request.auth.uid + '_.*');
    }

    // ---------- Sessões de Julgamento (recursos contra multas condominiais) ----------
    // O escritório monta cada recurso (resumo + provas) e libera ao conselho do condomínio. Síndico e conselheiros
    // são contas de cliente (tipo cliente, conselheiro ou síndico) vinculadas pelo admin em conselhoMembros/{uid}.condominios = { slug: 'sindico'|'conselheiro' }
    // e só enxergam o que foi liberado do PRÓPRIO condomínio. A decisão e a ementa são lançadas pelo escritório.
    function papelNoConselho(slug) {
      return exists(/databases/$(database)/documents/conselhoMembros/$(request.auth.uid))
        ? get(/databases/$(database)/documents/conselhoMembros/$(request.auth.uid)).data.get('condominios', {}).get(slug, '')
        : '';
    }
    function doConselho(slug) {
      return isContaCliente() && papelNoConselho(slug) in ['sindico', 'conselheiro'];
    }
    // Na equipe, as Sessões são ÁREA RESTRITA (07/11/2026): só o admin e quem tem a sub-aba "sessoes-julgamento"
    // da aba Condomínios liberada em Editar abas. O id da aba Condomínios fica em configPortal/abas
    // (gravado pelo portal quando o admin entra), porque o id é gerado quando a aba é criada.
    function abaCondominios() {
      return get(/databases/$(database)/documents/configPortal/abas).data.get('condominios', '');
    }
    function podeSessoes() {
      return isAdmin() || (isEquipe() && exists(/databases/$(database)/documents/configPortal/abas)
                           && meuCadastro().get('tabs', []).hasAny([abaCondominios()])
                           && meuCadastro().get('subtabs', {}).get(abaCondominios(), []).hasAny(['sessoes-julgamento']));
    }
    match /configPortal/{docId} {
      allow read: if isAtivo();
      allow write: if isAdmin();
    }
    match /conselhoMembros/{uid} {
      allow read: if podeSessoes() || (isAtivo() && request.auth.uid == uid);
      allow write: if isAdmin();
    }
    match /sessoesJulgamento/{sessaoId} {
      allow read: if podeSessoes() || (resource.data.liberada == true && doConselho(resource.data.condominioSlug));
      allow create, update: if podeSessoes() && request.resource.data.condominioSlug is string
                            && request.resource.data.condominioSlug.size() > 0;
      allow delete: if podeSessoes();
    }
    match /recursosJulgamento/{recursoId} {
      allow read: if podeSessoes() || (resource.data.liberado == true && doConselho(resource.data.condominioSlug));
      allow create, update: if podeSessoes() && request.resource.data.condominioSlug is string
                            && request.resource.data.condominioSlug.size() > 0
                            && request.resource.data.sessaoId is string;
      allow delete: if podeSessoes();
    }
    // anotações particulares do conselheiro: só ele lê (nem o escritório)
    match /anotacoesJulgamento/{docId} {
      allow read, delete: if isAtivo() && resource.data.uid == request.auth.uid;
      allow create, update: if isAtivo() && request.resource.data.uid == request.auth.uid
                            && docId == request.auth.uid + '_' + request.resource.data.recursoId;
    }
    // "analisei" de cada conselheiro (o escritório acompanha quem já leu antes da sessão)
    match /leiturasJulgamento/{docId} {
      allow read: if podeSessoes() || (isAtivo() && resource.data.uid == request.auth.uid);
      allow create, update: if request.resource.data.uid == request.auth.uid
                            && docId == request.auth.uid + '_' + request.resource.data.recursoId
                            && doConselho(request.resource.data.condominioSlug)
                            && get(/databases/$(database)/documents/recursosJulgamento/$(request.resource.data.recursoId)).data.condominioSlug
                               == request.resource.data.condominioSlug;
      allow delete: if false;
    }
    // trilha de auditoria: quem abriu cada prova (só cria; ninguém altera nem apaga)
    match /acessosProvasJulgamento/{docId} {
      allow read: if podeSessoes();
      allow create: if request.resource.data.uid == request.auth.uid
                    && request.resource.data.em == request.time
                    && (podeSessoes() || doConselho(request.resource.data.condominioSlug));
      allow update, delete: if false;
    }
    // Monitor dos computadores do escritório (16/11/2026): o OtimizadorPC.exe (otimizador-pc/) grava sem login (REST), só com a
    // chave do escritório embutida no app (privado/monitor-chave.txt, fora do repositório). Aqui fica só o SHA-256
    // dela. Só o admin lê e apaga (painel tools/monitor-pcs). Gravação com formato e tamanhos travados.
    function chaveMonitor() {
      return request.resource.data.chave is string && request.resource.data.chave.size() <= 100
          && hashing.sha256(request.resource.data.chave).toHexString().lower()
             == '55d6202d35ea867c010f302ac94a109a5668f3cf224618a6669fa45814856320';
    }
    match /monitorPCs/{pc} {
      allow read, delete: if isAdmin();
      allow create, update: if chaveMonitor() && pc.size() <= 50
          && request.resource.data.keys().hasOnly(['chave', 'pc', 'usuario', 'versao', 'atualizadoEm', 'ate', 'ram', 'livreGB',
               'commit', 'cpu', 'chromeMB', 'chromeN', 'top', 'cpuTop', 'travado', 'ramTotalGB', 'ligadoDias', 'ajustes',
               'hardware', 'achados', 'extensoes', 'comandoId', 'comandoStatus', 'comandoResultado', 'comandoEm'])
          && request.resource.data.top is list && request.resource.data.top.size() <= 10
          && request.resource.data.cpuTop is list && request.resource.data.cpuTop.size() <= 10
          && request.resource.data.achados is list && request.resource.data.achados.size() <= 20
          && request.resource.data.extensoes is list && request.resource.data.extensoes.size() <= 40
          && request.resource.data.hardware is string && request.resource.data.hardware.size() <= 1500
          && request.resource.data.atualizadoEm is timestamp;
      match /amostras/{id} {
        allow read, delete: if isAdmin();
        allow create, update: if chaveMonitor() && id.size() <= 20
            && request.resource.data.keys().hasOnly(['chave', 't', 's'])
            && request.resource.data.t is timestamp
            && request.resource.data.s is list && request.resource.data.s.size() <= 20;
      }
    }
    // Comandos do painel para cada computador (Otimizar agora / Atualizar diagnóstico / Avisar para reiniciar).
    // Só o admin pede; o app lê sem login (por isso o pedido tem só id, ação e hora — nada sensível; a chave nunca
    // vai aqui) e devolve o resultado em monitorPCs/{pc}. Listar, só o admin.
    match /monitorComandos/{pc} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['id', 'acao', 'pedidoEm'])
          && request.resource.data.id is string && request.resource.data.id.size() <= 40
          && request.resource.data.acao in ['otimizar', 'diagnostico', 'avisar-reiniciar']
          && request.resource.data.pedidoEm == request.time;
    }
  }
}
