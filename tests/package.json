{
  "name": "portal-fb-testes-seguranca",
  "private": true,
  "scripts": {
    "test:firestore": "firebase emulators:exec --only firestore --project demo-portal-regras \"node firestore-rules/regras.test.js\"",
    "test:storage": "firebase emulators:exec --only firestore,storage --project demo-portal-regras \"node storage-rules/storage.test.js\"",
    "test:worker": "node worker-assistente/worker.test.mjs",
    "test": "npm run test:firestore && npm run test:storage && npm run test:worker"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.13.0",
    "firebase-tools": "^13.0.0"
  }
}
